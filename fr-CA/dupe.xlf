<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
  <file original="cm-metadata-iasworld_messages" source-language="en-US" target-language="fr-CA" datatype="plaintext">
    <body>
      <!-- Case 1: the same id twice directly in one <file> (the failing run's shape) -->
      <trans-unit id="AttachmentTitle">
        <source>Attachment title</source>
      </trans-unit>
      <trans-unit id="AttachmentDescription">
        <source>Describe the attachment</source>
      </trans-unit>
      <trans-unit id="AttachmentTitle">
        <source>Title of the attachment</source>
      </trans-unit>

      <!-- Case 2: repeats inside a group WITHOUT an id (it adds no scope) -->
      <group>
        <trans-unit id="SaveButton">
          <source>Save</source>
        </trans-unit>
        <trans-unit id="SaveButton">
          <source>Save changes</source>
        </trans-unit>
      </group>

      <!-- Control: same id in groups WITH ids — distinct scopes, not repeats -->
      <group id="toolbar">
        <trans-unit id="Close">
          <source>Close</source>
        </trans-unit>
      </group>
      <group id="dialog">
        <trans-unit id="Close">
          <source>Close window</source>
        </trans-unit>
      </group>

      <!-- Markup + CDATA inside a repeated id -->
      <trans-unit id="HelpText">
        <source>Click <g id="1">here</g> for help.</source>
      </trans-unit>
      <trans-unit id="HelpText">
        <source><![CDATA[Need help? Use <b>F1</b>.]]></source>
      </trans-unit>
    </body>
  </file>

  <!-- Case 3: a second <file> with the SAME original repeats an id from the first -->
  <file original="cm-metadata-iasworld_messages" source-language="en-US" target-language="fr-CA" datatype="plaintext">
    <body>
      <trans-unit id="AttachmentTitle">
        <source>Attachment name</source>
      </trans-unit>
    </body>
  </file>
</xliff>
